+func TestUtlsConnectionAddressFamily(t *testing.T) {
+	for _, tc := range []struct{ setting, want string }{{"", "tcp"}, {"0", "tcp"}, {"1", "tcp4"}} {
+		t.Run(tc.setting+tc.want, func(t *testing.T) {
+			t.Setenv("CLIPROXY_FORCE_IPV4", tc.setting)
+			stopped := errors.New("stop before TLS handshake")
+			dialer := contextDialerFunc(func(ctx context.Context, network, addr string) (net.Conn, error) {
+				if network != tc.want {
+					t.Fatalf("dial network = %q, want %q", network, tc.want)
+				}
+				if addr != "chatgpt.com:443" {
+					t.Fatalf("dial address = %q", addr)
+				}
+				return nil, stopped
+			})
+			transport := &utlsRoundTripper{dialer: dialer}
+			_, err := transport.createConnection(context.Background(), "chatgpt.com", "chatgpt.com:443")
+			if !errors.Is(err, stopped) {
+				t.Fatalf("connection error = %v, want dial error", err)
+			}
+		})
+	}
+}
