+// quotaRecheckEnv names the environment variable that bounds quota cooldowns.
+const quotaRecheckEnv = "CLIPROXY_QUOTA_RECHECK_SECONDS"
+
+// quotaRecheckInterval returns the longest time a quota failure may keep a
+// credential out of rotation, or 0 when unbounded (the upstream behaviour).
+// A usage-limit cooldown is taken from the reset time the provider reported at
+// failure; when the account is reset or upgraded earlier, nothing would clear
+// it. Bounding it makes the next request probe the provider again, so a reset
+// takes effect within one interval and a still-limited account costs at most
+// one rejected request per interval per credential.
+func quotaRecheckInterval() time.Duration {
+	seconds, err := strconv.Atoi(strings.TrimSpace(os.Getenv(quotaRecheckEnv)))
+	if err != nil || seconds <= 0 {
+		return 0
+	}
+	return time.Duration(seconds) * time.Second
+}
+
+// capQuotaCooldown limits a quota cooldown to the recheck interval.
+func capQuotaCooldown(cooldown time.Duration) time.Duration {
+	if limit := quotaRecheckInterval(); limit > 0 && cooldown > limit {
+		return limit
+	}
+	return cooldown
+}
